	<queryString language="SQL">
		<![CDATA[SELECT k.id_karyawan, k.nik, k.nama_karyawan, k.jenis_kelamin, k.alamat, k.no_hp,
       d.nama_divisi, j.nama_jabatan
FROM karyawan k
LEFT JOIN divisi d ON d.id_divisi = k.id_divisi
LEFT JOIN jabatan j ON j.id_jabatan = k.id_jabatan
ORDER BY k.id_karyawan ASC]]>
	</queryString>
