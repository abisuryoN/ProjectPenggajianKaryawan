              name="slip_gaji" pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30"
              uuid="1b4351de-e864-4d84-bc95-8f21e637d1b1">
    <style name="Base" fontName="SansSerif" fontSize="10" forecolor="#000000"/>
    <style name="Title" style="Base" fontSize="16" isBold="true"/>
    <style name="Label" style="Base" isBold="true"/>
    <style name="Total" style="Base" fontSize="12" isBold="true"/>

    <parameter name="id_gaji" class="java.lang.Integer"/>
    <queryString language="SQL">
        <![CDATA[
SELECT
    p.id_penggajian,
    k.nik,
    k.nama_karyawan,
    j.nama_jabatan,
    d.nama_divisi,
    p.periode,
    CASE SUBSTRING(p.periode, 6, 2)
        WHEN '01' THEN 'Januari'
        WHEN '02' THEN 'Februari'
        WHEN '03' THEN 'Maret'
        WHEN '04' THEN 'April'
        WHEN '05' THEN 'Mei'
        WHEN '06' THEN 'Juni'
        WHEN '07' THEN 'Juli'
        WHEN '08' THEN 'Agustus'
        WHEN '09' THEN 'September'
        WHEN '10' THEN 'Oktober'
        WHEN '11' THEN 'November'
        WHEN '12' THEN 'Desember'
        ELSE SUBSTRING(p.periode, 6, 2)
    END AS bulan,
    SUBSTRING(p.periode, 1, 4) AS tahun,
    p.gaji_pokok,
    p.total_tunjangan AS tunjangan,
    p.potongan,
    p.total_gaji,
    p.tanggal_gaji,
    '' AS keterangan
FROM penggajian p
JOIN karyawan k ON k.id_karyawan = p.id_karyawan
LEFT JOIN jabatan j ON j.id_jabatan = k.id_jabatan
LEFT JOIN divisi d ON d.id_divisi = k.id_divisi
WHERE p.id_penggajian = $P{id_gaji}
        ]]>
    </queryString>

    <field name="nik" class="java.lang.String"/>
    <field name="nama_karyawan" class="java.lang.String"/>
    <field name="nama_jabatan" class="java.lang.String"/>
    <field name="nama_divisi" class="java.lang.String"/>
