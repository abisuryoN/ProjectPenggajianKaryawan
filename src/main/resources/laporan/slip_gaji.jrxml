    <field name="tahun" class="java.lang.String"/>
    <field name="gaji_pokok" class="java.math.BigDecimal"/>
    <field name="tunjangan" class="java.math.BigDecimal"/>
    <field name="potongan" class="java.math.BigDecimal"/>
    <field name="total_gaji" class="java.math.BigDecimal"/>
    <field name="tanggal_gaji" class="java.sql.Date"/>
    <field name="keterangan" class="java.lang.String"/>

