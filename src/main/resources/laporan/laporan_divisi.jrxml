              uuid="b011529d-85c2-4d6f-bf87-1a78ce35670f">
    <style name="Base" fontName="SansSerif" fontSize="9" forecolor="#000000"/>
    <style name="Title" style="Base" fontSize="16" isBold="true"/>
    <style name="Header" style="Base" isBold="true"/>

    <queryString language="SQL">
        <![CDATA[
SELECT d.id_divisi, d.nama_divisi, COALESCE(d.kepala_divisi, '') AS kepala_divisi, d.keterangan, COUNT(k.id_karyawan) AS jumlah_karyawan
FROM divisi d
LEFT JOIN karyawan k ON k.id_divisi = d.id_divisi
GROUP BY d.id_divisi, d.nama_divisi, d.kepala_divisi, d.keterangan
ORDER BY d.id_divisi ASC
        ]]>
    </queryString>
    <field name="id_divisi" class="java.lang.Integer"/>
    <field name="nama_divisi" class="java.lang.String"/>
    <field name="kepala_divisi" class="java.lang.String"/>
    <field name="jumlah_karyawan" class="java.lang.Long"/>
    <field name="keterangan" class="java.lang.String"/>

