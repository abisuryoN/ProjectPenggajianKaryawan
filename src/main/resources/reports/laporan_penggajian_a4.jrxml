	<style name="Base" forecolor="#000000" fontName="SansSerif" fontSize="9"/>
	<style name="Title" style="Base" fontSize="16" isBold="true"/>
	<style name="Subtitle" style="Base" fontSize="9"/>
	<style name="ColumnHeader" style="Base" fontSize="8" isBold="true"/>
	<style name="TableCell" style="Base" fontSize="8"/>
	<parameter name="id_gaji" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    k.nama_karyawan,
    CASE SUBSTRING(p.periode, 6, 2)
        WHEN '01' THEN 'Januari'
        WHEN '02' THEN 'Februari'
        WHEN '03' THEN 'Maret'
        WHEN '04' THEN 'April'
        WHEN '05' THEN 'Mei'
        WHEN '06' THEN 'Juni'
        WHEN '07' THEN 'Juli'
        WHEN '08' THEN 'Agustus'
        WHEN '09' THEN 'September'
        WHEN '10' THEN 'Oktober'
        WHEN '11' THEN 'November'
        WHEN '12' THEN 'Desember'
        ELSE SUBSTRING(p.periode, 6, 2)
    END AS bulan,
    SUBSTRING(p.periode, 1, 4) AS tahun,
    p.gaji_pokok,
    p.total_tunjangan AS tunjangan,
    p.potongan,
    p.total_gaji,
    '' AS keterangan
FROM penggajian p
JOIN karyawan k ON k.id_karyawan = p.id_karyawan
WHERE ($P{id_gaji} IS NULL OR p.id_penggajian = $P{id_gaji})
ORDER BY p.id_penggajian DESC]]>
	</queryString>
	<field name="nama_karyawan" class="java.lang.String"/>
	<field name="bulan" class="java.lang.String"/>
	<field name="tahun" class="java.lang.String"/>
	<field name="gaji_pokok" class="java.math.BigDecimal"/>
	<field name="tunjangan" class="java.math.BigDecimal"/>
	<field name="potongan" class="java.math.BigDecimal"/>
	<field name="total_gaji" class="java.math.BigDecimal"/>
	<field name="keterangan" class="java.lang.String"/>
	<variable name="nomor" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{nama_karyawan}]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
