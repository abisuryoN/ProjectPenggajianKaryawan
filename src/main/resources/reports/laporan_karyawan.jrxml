    <style name="Title" style="Base" fontSize="16" isBold="true"/>
    <style name="Header" style="Base" fontSize="9" isBold="true"/>

    <queryString language="SQL">
        <![CDATA[
SELECT k.id_karyawan, k.nik, k.nama_karyawan, k.jenis_kelamin, k.alamat, k.no_hp,
       d.nama_divisi, j.nama_jabatan
FROM karyawan k
LEFT JOIN divisi d ON d.id_divisi = k.id_divisi
LEFT JOIN jabatan j ON j.id_jabatan = k.id_jabatan
ORDER BY k.id_karyawan ASC
        ]]>
    </queryString>
    <field name="id_karyawan" class="java.lang.Integer"/>
    <field name="nik" class="java.lang.String"/>
    <field name="nama_karyawan" class="java.lang.String"/>
    <field name="jenis_kelamin" class="java.lang.String"/>
    <field name="alamat" class="java.lang.String"/>
    <field name="no_hp" class="java.lang.String"/>
    <field name="nama_divisi" class="java.lang.String"/>
    <field name="nama_jabatan" class="java.lang.String"/>

